{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rad-plan/stack-eval.schema.json",
  "title": "RAD Plan stack advisor output contract",
  "type": "object",
  "required": [
    "evaluation_complete",
    "project_type",
    "summary",
    "current_stack_fit",
    "recommendation",
    "compatibility_verified",
    "confidence",
    "escalation_required"
  ],
  "properties": {
    "evaluation_complete": {"type": "boolean", "const": true},
    "project_type": {"type": "string"},
    "summary": {"type": "string"},
    "current_stack_fit": {
      "enum": ["fits", "partly_fits", "does_not_fit", "no_current_stack"]
    },
    "recommendation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layer", "choice", "version", "requirement", "rationale"],
        "properties": {
          "layer": {"type": "string"},
          "choice": {"type": "string"},
          "version": {"type": "string"},
          "requirement": {"type": "string"},
          "rationale": {"type": "string"}
        }
      }
    },
    "alternatives_considered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer", "alternative", "why_rejected"],
        "properties": {
          "layer": {"type": "string"},
          "alternative": {"type": "string"},
          "why_rejected": {"type": "string"}
        }
      }
    },
    "new_burden": {"type": "array", "items": {"type": "string"}},
    "compatibility_verified": {
      "type": "boolean",
      "description": "When true, validate-json.py requires at least one verification_sources entry."
    },
    "compatibility_notes": {"type": "array", "items": {"type": "string"}},
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk", "mitigation"],
        "properties": {
          "risk": {"type": "string"},
          "mitigation": {"type": "string"}
        }
      }
    },
    "version_pins": {"type": "object"},
    "verification_sources": {
      "description": "Sources that support compatibility claims; required when compatibility_verified is true.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url", "checked_on"],
        "properties": {
          "title": {"type": "string"},
          "url": {"type": "string"},
          "checked_on": {"type": "string"}
        }
      }
    },
    "confidence": {"enum": ["high", "medium", "low"]},
    "escalation_required": {"type": "boolean"},
    "escalation_reason": {"type": "string"}
  }
}
